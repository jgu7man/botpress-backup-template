{
  "name": "my-bot",
  "version": "1.0.0",
  "description": "Botpress coder workspace to manage bot programming",
  "main": "index.js",
  "scripts": {
    "unfold-bot": "tsx ./tools/bot-unfolder/core/main.ts",
    "export-tables": "tsx ./tools/bot-table-exporter/run.ts",
    "extract": "tsx ./tools/smart-extractor/main.ts",
    "compress": "rm -rf ./exports/$ENV/assistant-$ENV.bpz && 7z a -tzip -mx=9 ./exports/$ENV/assistant-$ENV.bpz ./bots/$ENV/*",
    "compress:dev": "ENV=dev && npm run compress",
    "compress:stg": "ENV=stg && npm run compress",
    "compress:prod": "ENV=prod && npm run compress",
    "test": "echo \"Error: no test specified\" && exit 1",
    "generate-signing-key": "ts-node ./utils/signing-key-generator/manually-signing.ts"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/inquirer": "^9.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.14.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "zod": "^3.24.3"
  },
  "dependencies": {
    "@botpress/client": "^1.6.0",
    "axios": "^1.11.0",
    "inquirer": "^9.2.12",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.6.1",
    "notion-types": "^7.4.3",
    "tsx": "^4.6.0"
  }
}
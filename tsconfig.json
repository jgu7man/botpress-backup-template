{
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "compilerOptions": {
      "module": "CommonJS"
    }
  },
  "compilerOptions": {
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["."],
      "@test/*": ["./test/*"],
      "@workflows/*": ["bot/src/workflows/*"],
      "@variables/*": ["bot/src/variables/*"],
      "@schemas/*": ["bot/src/schemas/*"],
      "@tables/*": ["bot/src/tables/*"],
      "@core-types/*": ["types/core/*"],
      "@types/*": ["types/*"],
      "@globals/*": ["types/globals/*"]
    },
    "lib": ["es2019"],
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strictPropertyInitialization": false
  },
  "include": ["**/*", "**/*.d.ts"]
}
